{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessLoneBlockStatements": "off",
				"noForEach": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noArrayIndexKey": "off"
			},
			"correctness": {
				"noUnreachable": "off"
			},
			"a11y": {
				"noNoninteractiveTabindex": "off"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/public/**"]
	}
}
